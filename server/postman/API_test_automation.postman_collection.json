  "item": [
    {
      "name": "Get songs",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"check number of songs\", ()=> {\n    const data = pm.response.json();\n    pm.expect(data.length == 7)\n});\n\npm.test(\"songs have all properties\", () => {\n    const data = pm.response.json();\n    console.log(data)\n    for (var i = 0; i< data.length; i++) {\n        pm.expect(data[i]).to.have.property(\"album\");\n        pm.expect(data[i]).to.have.property(\"title\");\n        pm.expect(data[i]).to.have.property(\"_id\");\n        pm.expect(data[i]).to.have.property(\"artist\");\n        pm.expect(data[i]).to.have.property(\"tags\");\n    }\n})\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/songs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "songs"
          ]
        }
      },
      "response": []
    },
